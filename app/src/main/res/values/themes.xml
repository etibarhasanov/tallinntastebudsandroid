<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints every pixel of every screen; this exists so the window
         behind it, and the splash before the first frame, are the app's paper
         rather than the platform's white. -->
    <style name="Theme.TallinnTasteBuds" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
